{
  "pack": "core",
  "version": "0.4.0",
  "description": "The basic things of a Castellan world: people, trees, stones, what people can know, and the first pieces of a mind.",
  "types": {
    "Person": {
      "kind": "entity",
      "leaf": true,
      "description": "A person's body in the world. Their mind and knowledge are edges to shared nodes.",
      "attrs": {
        "name": {
          "type": "string",
          "default": {
            "expr": "pick(\"Ayla\", \"Bora\", \"Cem\", \"Defne\", \"Eda\", \"Fen\", \"Gül\", \"Ilka\", \"Jale\", \"Kaan\", \"Lale\", \"Mert\", \"Nil\", \"Oren\", \"Pia\", \"Rua\", \"Sena\", \"Tarik\", \"Una\", \"Vera\", \"Yaz\", \"Zeki\", \"Aras\", \"Bel\", \"Ece\", \"Ira\", \"Mira\", \"Nehir\", \"Ozan\", \"Tuna\")"
          }
        },
        "age": {
          "type": "number",
          "min": 0,
          "default": {
            "expr": "rand_int(16, 45)"
          },
          "description": "Years."
        },
        "determination": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": {
            "expr": "round(rand_range(0.1, 0.9) * 100) / 100"
          },
          "description": "How strongly they stick with what they are doing (ADR-0016)."
        },
        "carrying": {
          "type": "number",
          "min": 0,
          "default": 0,
          "description": "Material units in hand (set by the engine)."
        }
      }
    },
    "Tree": {
      "kind": "entity",
      "leaf": true,
      "memorable": true,
      "description": "A tree; a source of wood. New ones spread near old ones on fertile land.",
      "spread": {
        "every": 2,
        "count": 4,
        "radius": 4,
        "field": "fertility"
      },
      "attrs": {
        "wood": {
          "type": "number",
          "min": 0,
          "default": {
            "expr": "rand_int(4, 12)"
          },
          "description": "Units of wood it can give."
        }
      },
      "remember": [
        "wood"
      ]
    },
    "Stone": {
      "kind": "entity",
      "leaf": true,
      "memorable": true,
      "description": "A loose stone or boulder.",
      "attrs": {
        "size": {
          "type": "number",
          "min": 1,
          "max": 3,
          "default": {
            "expr": "rand_int(1, 3)"
          }
        }
      }
    },
    "Sighting": {
      "kind": "knowledge",
      "description": "A claim that something is at a place, with what was noticed about it (ADR-0015). What it is about is the `about` edge. Memories fade unless seen again.",
      "attrs": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "memory": {
        "recall": 0.85,
        "fade": -0.02,
        "reinforce": "confidence + (1 - confidence) * 0.6",
        "forgetBelow": 0.2
      }
    },
    "Fear": {
      "kind": "mind",
      "role": "need",
      "description": "The need to feel safe. Rises fast after dark, fades by day.",
      "start": 0,
      "rate": {
        "expr": "if(night, 6, -8)"
      },
      "urgentAt": 0.6
    },
    "Fatigue": {
      "kind": "mind",
      "role": "need",
      "description": "Tiredness. Builds while active, drops while resting.",
      "start": {
        "expr": "rand_range(0.1, 0.3)"
      },
      "rate": {
        "expr": "if(doing == \"Rest\", -0.5, 0.25)"
      },
      "urgentAt": 0.8
    },
    "Survive": {
      "kind": "mind",
      "role": "goal",
      "tier": 1,
      "weight": {
        "expr": "needs.Fear"
      },
      "description": "Stay alive and safe."
    },
    "Recover": {
      "kind": "mind",
      "role": "goal",
      "tier": 2,
      "weight": {
        "expr": "needs.Fatigue * if(night, 1, 0.5)"
      },
      "description": "Get rest."
    },
    "Grow": {
      "kind": "mind",
      "role": "goal",
      "tier": 4,
      "weight": 0.3,
      "description": "Curiosity: see and learn the world."
    },
    "Explore": {
      "kind": "mind",
      "role": "action",
      "description": "Walk toward the unknown. Curiosity fades as the land becomes familiar.",
      "serves": {
        "Grow": {
          "expr": "max(0.2, 1 - knows.Tree / 80)"
        }
      },
      "steps": [
        {
          "goto": {
            "explore": true
          }
        }
      ]
    },
    "Wander": {
      "kind": "mind",
      "role": "action",
      "description": "Stroll around nearby.",
      "serves": {
        "Grow": 0.6
      },
      "steps": [
        {
          "goto": {
            "wander": 6
          }
        }
      ]
    },
    "Rest": {
      "kind": "mind",
      "role": "action",
      "description": "Rest; at home if they have one (they walk back first). At night it is also how they stay safe.",
      "serves": {
        "Survive": {
          "expr": "if(night, 1, 0)"
        },
        "Recover": 1
      },
      "steps": [
        {
          "goto": "home",
          "optional": true
        },
        {
          "stay": true
        }
      ]
    }
  },
  "edges": {
    "knows": {
      "from": "entity",
      "to": "knowledge",
      "description": "A person holds a claim. The person's side carries when and how they learned it.",
      "fromData": {
        "learnedAt": {
          "type": "number"
        },
        "confidence": {
          "type": "number",
          "min": 0,
          "max": 1,
          "default": 1
        }
      }
    },
    "about": {
      "from": "knowledge",
      "to": "entity",
      "description": "What a claim refers to."
    },
    "has": {
      "from": "entity",
      "to": "mind",
      "description": "A person has a need or goal. For needs, their own level (a lazy value) sits on their end.",
      "fromData": {
        "level": {
          "type": "number",
          "min": 0,
          "max": 1
        }
      }
    }
  },
  "place": {
    "Tree": {
      "count": 260,
      "prefer": "fertility",
      "avoid": {
        "water": 0.05
      }
    },
    "Stone": {
      "count": 60,
      "avoid": {
        "water": 0.05
      }
    },
    "Person": {
      "count": 6,
      "avoid": {
        "water": 0.05
      }
    }
  }
}

{
  "pack": "hostility",
  "version": "0.1.0",
  "description": "Grudges and anger. Finding something you remembered emptied by someone else leaves a grudge against them; meeting them makes you angry; anger is vented by confronting them, and fades with time.",
  "requires": ["core"],
  "types": {
    "Anger": {
      "kind": "mind",
      "role": "need",
      "description": "Flares on bad encounters, cools by itself.",
      "start": 0,
      "rate": -0.4,
      "urgentAt": 0.8
    },
    "Vent": {
      "kind": "mind",
      "role": "goal",
      "tier": 3,
      "weight": "needs.Anger",
      "description": "Getting anger out."
    },
    "Confront": {
      "kind": "mind",
      "role": "action",
      "description": "Go to someone they hold a grudge against and have it out.",
      "steps": [
        { "goto": { "linked": "grudge" } },
        { "work": 0.01 },
        { "effect": { "needs.Anger": -0.6 } }
      ],
      "serves": { "Vent": "if(needs.Anger > 0.4, 1.2, 0)" }
    }
  },
  "edges": {
    "grudge": { "from": "entity", "to": "entity", "description": "A person holds something against another person." }
  },
  "reactions": [
    {
      "on": "found-empty",
      "if": "it.lastTakenBy > 0 and it.lastTakenBy != self.id",
      "do": { "link": { "edge": "grudge", "to": "it.lastTakenBy" }, "needs.Anger": 0.25 }
    },
    {
      "on": "meets",
      "if": "rel.grudge",
      "do": { "needs.Anger": 0.35 }
    }
  ]
}

{
  "pack": "shelter",
  "version": "0.4.0",
  "description": "People need shelter: Molly plans houses where need, wood and land line up; people gather wood and build them; houses close together become a village.",
  "requires": [
    "core"
  ],
  "types": {
    "Shelter": {
      "kind": "mind",
      "role": "need",
      "description": "Having a safe place to sleep. Falls once they live in a house.",
      "start": {
        "expr": "rand_range(0.2, 0.4)"
      },
      "rate": {
        "expr": "if(home, -0.5, if(night, 0.12, 0.05))"
      },
      "urgentAt": 0.8
    },
    "Secure": {
      "kind": "mind",
      "role": "goal",
      "tier": 2,
      "weight": {
        "expr": "needs.Shelter"
      },
      "description": "Secure a place to live."
    },
    "Gather": {
      "kind": "mind",
      "role": "action",
      "description": "Walk to a tree they remember having wood, cut, and take up to a load.",
      "steps": [
        {
          "goto": {
            "known": "Tree",
            "where": "it.wood > 0"
          }
        },
        {
          "work": 0.04
        },
        {
          "take": {
            "from": "wood",
            "to": "carrying",
            "amount": "min(4 - self.carrying, plan.missing - self.carrying)"
          }
        }
      ],
      "gives": [
        "hasLoad"
      ],
      "knowhow": {
        "innate": 0.8,
        "watch": 0.4
      },
      "words": {
        "doing": "gathering wood",
        "did": "gathered wood",
        "purpose": "get wood",
        "name": "cut wood"
      }
    },
    "Deliver": {
      "kind": "mind",
      "role": "action",
      "description": "Carry the wood in hand to the building site.",
      "steps": [
        {
          "goto": "plan"
        },
        {
          "give": {
            "from": "carrying",
            "to": "stock",
            "amount": "self.carrying"
          }
        }
      ],
      "requires": [
        "hasLoad"
      ],
      "gives": [
        "siteReady"
      ],
      "words": {
        "doing": "carrying wood to the site",
        "did": "carried wood to the site",
        "purpose": "get the site ready",
        "name": "carry wood"
      }
    },
    "Build": {
      "kind": "mind",
      "role": "action",
      "description": "Work on the house once all the wood is there; then move in. Not everyone knows how at first.",
      "steps": [
        {
          "goto": "plan"
        },
        {
          "work": "plan.workLeft",
          "progress": "worked"
        },
        {
          "finish": "plan"
        }
      ],
      "serves": {
        "Secure": "if(plan.active, 1, 0)"
      },
      "requires": [
        "siteReady"
      ],
      "knowhow": {
        "innate": 0.7,
        "watch": 0.5
      },
      "words": {
        "doing": "building",
        "did": "built",
        "purpose": "build a house",
        "name": "build a house"
      }
    },
    "House": {
      "kind": "entity",
      "description": "A house. Starts as a concept Molly places; becomes real through gathering and work.",
      "attrs": {
        "state": {
          "type": "string",
          "default": "planned",
          "description": "planned or built (set by the engine)"
        },
        "stock": {
          "type": "number",
          "default": 0,
          "description": "Wood delivered to the site."
        },
        "worked": {
          "type": "number",
          "default": 0,
          "description": "Days of building done."
        }
      },
      "build": {
        "meets": "Shelter",
        "material": "Tree",
        "materialAttr": "wood",
        "amount": 10,
        "work": 0.5,
        "planner": "builds",
        "resident": "livesIn",
        "when": {
          "expr": "needs.Shelter"
        },
        "spot": {
          "expr": "clamp(0.4 + field.fertility - field.water * 2, 0, 1)"
        },
        "near": {
          "min": 2.5,
          "prefer": 9
        },
        "wear": 0.004
      }
    },
    "Village": {
      "kind": "entity",
      "description": "Houses close together, recognised and named by Molly.",
      "attrs": {
        "name": {
          "type": "string",
          "default": {
            "expr": "pick(\"Akpınar\", \"Eskidere\", \"Sarıçam\", \"Taşlık\", \"Yeşilova\", \"Karaağaç\", \"Değirmenli\", \"Kuzeybayır\", \"Ilıca\", \"Kayalı\", \"Söğütlü\", \"Gölbaşı\")"
          }
        }
      },
      "recognize": {
        "members": "House",
        "radius": 12,
        "min": 2,
        "full": 3,
        "formAt": 0.5,
        "memberEdge": "memberOf"
      }
    }
  },
  "edges": {
    "builds": {
      "from": "entity",
      "to": "entity",
      "description": "A person building a house (concept or finished)."
    },
    "livesIn": {
      "from": "entity",
      "to": "entity",
      "description": "A person's home."
    },
    "memberOf": {
      "from": "entity",
      "to": "entity",
      "description": "A house belongs to a village."
    }
  },
  "facts": {
    "hasLoad": "self.carrying > 0 and (self.carrying >= 4 or self.carrying >= plan.missing)",
    "siteReady": "plan.ready"
  },
  "watch": {
    "color": "#a06432",
    "tables": {
      "Builders": {
        "rows": "Person",
        "columns": {
          "Shelter need": "needs.Shelter",
          "Has a home": "home",
          "Building": "plan.active",
          "Wood missing": "plan.missing",
          "Carrying": "self.carrying"
        },
        "sort": "Shelter need"
      },
      "Houses": {
        "rows": "House",
        "columns": {
          "State": "self.state",
          "Wood at site": "self.stock",
          "Condition": "self.condition"
        }
      }
    },
    "logs": {
      "Building": {
        "Spot marked": {
          "on": "linked",
          "if": "edge == \"builds\" and by == \"molly\"",
          "text": "Molly marked a spot for {self.name}'s house"
        },
        "Moved in": {
          "on": "linked",
          "if": "edge == \"livesIn\"",
          "text": "{self.name} finished a house and moved in",
          "global": true
        }
      },
      "Villages": {
        "Formed": {
          "on": "created",
          "if": "type == \"Village\"",
          "text": "A village formed: {self.name}",
          "global": true,
          "emphasis": "strong"
        },
        "House joined": {
          "on": "linked",
          "if": "edge == \"memberOf\"",
          "text": "A house became part of {other.name}"
        }
      }
    }
  }
}
